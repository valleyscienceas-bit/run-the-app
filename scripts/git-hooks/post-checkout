#!/usr/bin/env bash
# Installed into .git/hooks/post-checkout by: npm run prepare
# Ensures frontend/backend npm deps after every branch switch.

prev_head="${1:-}"
new_head="${2:-}"
branch_checkout="${3:-}"

# File checkout (not branch switch) — skip
if [[ "$branch_checkout" != "1" ]]; then
  exit 0
fi

root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
[[ -n "$root" ]] || exit 0

echo "📦 Ensuring npm deps after branch switch..."

for dir in frontend backend; do
  if [[ -f "$root/$dir/package.json" ]]; then
    echo "  → npm install in $dir"
    (cd "$root/$dir" && npm install --no-fund --no-audit) || echo "  ⚠ npm install failed in $dir (continuing)"
  fi
done

echo "✅ deps ready"
