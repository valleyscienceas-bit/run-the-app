# AI Configuration
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Email Configuration (SMTP)
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Where demo-request / inquiry notifications are sent (defaults to SMTP_USER)
ADMIN_EMAIL=

# Public URL for approve links in emails (use your LAN IP when testing on other devices)
APP_BASE_URL=http://localhost:3000

# Firebase Admin (path to service account JSON, or leave blank to use Application Default Credentials)
GOOGLE_APPLICATION_CREDENTIALS=

# Server
PORT=3001
NODE_ENV=development

# Cron job auth — required for /api/cron/* endpoints
CRON_SECRET=

# Firestore backups (gcloud export — see backend/scripts/export-firestore.sh)
# GCS bucket URI, e.g. gs://valley-science-firestore-backups
GCS_BACKUP_BUCKET=
# Optional overrides (defaults from firebase-applet-config.json)
# GCP_PROJECT_ID=
# FIRESTORE_DATABASE_ID=
